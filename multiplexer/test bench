```verilog
`timescale 1ns/1ps

module mux_4to1_tb;

    reg [3:0] I;
    reg [1:0] S;
    wire Y;

    // Instantiate the 4:1 MUX
    mux_4to1 uut (
        .I(I),
        .S(S),
        .Y(Y)
    );

    initial begin

        $monitor("Time = %0t | I = %b | S = %b | Y = %b",
                 $time, I, S, Y);

        // Input values
        I = 4'b1010;

        // Select I0
        S = 2'b00;
        #10;

        // Select I1
        S = 2'b01;
        #10;

        // Select I2
        S = 2'b10;
        #10;

        // Select I3
        S = 2'b11;
        #10;

        // Change input values
        I = 4'b1101;

        S = 2'b00;
        #10;

        S = 2'b01;
        #10;

        S = 2'b10;
        #10;

        S = 2'b11;
        #10;

        $finish;
    end

endmodule
